# Google AI Studio keys (get free at aistudio.google.com)
# Keys MUST start with "AIza" to work with Google's API
GEMINI_API_KEY=your_primary_google_key_here
GEMINI_API_KEY_2=your_backup_google_key_here
GEMINI_API_KEY_3=your_third_backup_key_here
# Add more numbered keys as needed: GEMINI_API_KEY_4, GEMINI_API_KEY_5, etc.
# They are tried in order (1, 2, 3...) automatically when quota/auth fails.

# Optional. Leave this line out to use the built-in list of current models.
# MODEL_NAME=gemini-3.5-flash

# --- Optional: talk through OpenCode's gateway instead of Google ---
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=your_opencode_key_here
# OPENCODE_BASE_URL=https://your-gateway-base-url/v1
# OPENCODE_MODEL=nemotron-3.5-lightning-free

# Generic OpenAI-compatible endpoint (Ollama, Groq, OpenRouter, etc.)
# LLM_PROVIDER=opencode
# LLM_BASE_URL=https://api.openrouter.ai/v1
# LLM_API_KEY=your_openrouter_key_here
# LLM_MODEL=openrouter/auto
